# Application secret used to sign session cookies in later stages
SECRET_KEY="change-me-to-a-long-random-secret"

# Gemini API key for server-side AI features (never exposed to browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SQLite database URL (used from Stage 2 onwards)
DATABASE_URL="sqlite:///./spendsense.db"

# Environment: development | production
ENVIRONMENT="development"
