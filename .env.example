# Application secret used to sign session & CSRF cookies (set a strong 32+ char random string in production)
SECRET_KEY="change-me-to-a-long-random-secret"

# Gemini API key for server-side AI features (never exposed to browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database URL: local SQLite default, persistent disk SQLite, or PostgreSQL (postgresql://...)
DATABASE_URL="sqlite:///./spendsense.db"

# Directory for processed 256x256 WebP avatars (point to persistent storage in production)
UPLOAD_DIR="uploads/avatars"

# Environment: development | production (production enforces Secure HTTPS cookies)
ENVIRONMENT="development"
